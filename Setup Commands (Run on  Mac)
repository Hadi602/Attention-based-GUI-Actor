# Step 1: Create the repository
cd ~/Desktop
git clone https://github.com/YOUR_USERNAME/adaptive-zoom-grounding.git
cd adaptive-zoom-grounding

# Step 2: Create folder structure
mkdir -p src/azg
mkdir -p eval
mkdir -p experiments/configs
mkdir -p experiments/results
mkdir -p notebooks
mkdir -p docs/figures
mkdir -p paper/figures

# Step 3: Create initial files
touch src/__init__.py
touch src/azg/__init__.py
touch src/azg/entropy.py
touch src/azg/zoom.py
touch src/azg/inference_azg.py
touch eval/screenSpot_pro_azg.py
touch eval/run_eval_azg.sh
touch docs/method.md
touch docs/architecture.md
touch docs/reproduction.md

# Step 4: Create requirements.txt
cat > requirements.txt << 'EOF'
torch>=2.0.0
transformers>=4.37.0
Pillow>=10.0.0
numpy>=1.24.0
tqdm>=4.65.0
qwen-vl-utils
EOF

# Step 5: Create setup.py
cat > setup.py << 'EOF'
from setuptools import setup, find_packages

setup(
    name="adaptive-zoom-grounding",
    version="0.1.0",
    packages=find_packages(where="src"),
    package_dir={"": "src"},
    install_requires=[
        "torch>=2.0.0",
        "transformers>=4.37.0",
        "Pillow>=10.0.0",
        "numpy>=1.24.0",
    ],
)
EOF

# Step 6: Initial commit
git add .
git commit -m "initial project structure"
git push origin main
